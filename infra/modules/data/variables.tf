variable "name" {
  description = "Prefix for resource names, e.g. engops-portal-dev."
  type        = string
}

variable "db_subnet_ids" {
  description = "Private DB subnets (one per AZ). RDS requires at least 2 AZs in its subnet group."
  type        = list(string)
}

variable "db_sg_id" {
  description = "Security group that only allows 5432 from the app tier."
  type        = string
}

variable "db_instance_class" {
  description = "Small and Free-plan eligible."
  type        = string
  default     = "db.t4g.micro"
}

variable "db_engine_version" {
  description = "PostgreSQL major version (RDS picks the current default minor)."
  type        = string
  default     = "17"
}

variable "db_name" {
  description = "Initial database created inside PostgreSQL."
  type        = string
  default     = "engops"
}

variable "db_username" {
  description = "Master username. The PASSWORD is generated by RDS and stored in Secrets Manager."
  type        = string
  default     = "engops_admin"
}

variable "files_bucket_name" {
  description = "Bucket for request attachments and reports."
  type        = string
}

variable "force_destroy_bucket" {
  description = "Allow terraform destroy to delete the bucket even if it holds files. true for dev only."
  type        = bool
  default     = false
}
